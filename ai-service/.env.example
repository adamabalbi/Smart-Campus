# ===== AI-service Smart Campus (Flask) — variables d'environnement =====

# Port : en local 5001. Sur Render, laissé vide (Render fournit PORT ;
# gunicorn écoute sur $PORT via le Procfile).
PORT=5001

# Chemin du modèle. Optionnel : par défaut le service cherche
# smart_campus_random_forest_model.joblib à la racine du repo puis dans ce dossier.
# MODEL_PATH=/opt/render/project/src/smart_campus_random_forest_model.joblib

# CORS : origines autorisées. Par défaut "*" (appels server-to-server depuis le
# backend). Pour restreindre : URL du backend Render.
AI_CORS_ORIGINS=*
# Exemple : AI_CORS_ORIGINS=https://smart-campus-api.onrender.com
