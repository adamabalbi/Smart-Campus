# ===== Smart Campus — Agent NFC local =====
# Copiez ce fichier en .env sur chaque poste équipé d'un lecteur ACR122U.

# URL du backend cloud (Render) — sans slash final.
BACKEND_URL=https://smart-campus-api.onrender.com
# En développement local : BACKEND_URL=http://localhost:5000

# Token machine partagé avec le backend (variable NFC_AGENT_TOKEN côté backend).
# Doit être identique des deux côtés.
NFC_AGENT_TOKEN=remplacez_par_le_meme_token_que_le_backend

# Identifiant du poste/kiosque (apparaît dans les logs). Optionnel.
AGENT_ID=kiosk-hall-batiment-a
