# ===== Backend Smart Campus — variables d'environnement =====
# Copiez ce fichier en .env (local) ou configurez ces variables dans le
# dashboard Render (NE JAMAIS committer le .env réel).

# Port d'écoute. En local : 5000. Sur Render : laissé vide (Render fournit PORT).
PORT=5000

# Origines autorisées par CORS (séparées par des virgules).
# Local : ports du frontend. Prod : URL Netlify/Vercel du frontend.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000
# Exemple prod : CORS_ORIGIN=https://smart-campus.netlify.app

# MongoDB Atlas — chaîne de connexion (Atlas > Database > Connect > Drivers).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_campus_db?retryWrites=true&w=majority

# Secret JWT — générer une valeur aléatoire forte :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacez_par_un_secret_aleatoire_long

# ===== Email (OTP, notifications) =====
# EMAIL_FROM est utilisé dans les deux modes (expéditeur).
EMAIL_FROM=Smart Campus <votre.adresse@gmail.com>

# --- Mode CLOUD (Render) : API HTTP Brevo (le SMTP est bloqué sur Render) ---
# Créez un compte gratuit sur https://www.brevo.com → SMTP & API → API Keys.
# Validez votre adresse expéditeur (EMAIL_FROM) dans Brevo (Senders).
# Si BREVO_API_KEY est défini, l'envoi passe par Brevo (port 443).
BREVO_API_KEY=

# --- Mode LOCAL : SMTP classique (ex. Gmail App Password) ---
# Utilisé uniquement si BREVO_API_KEY est vide.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASS=mot_de_passe_application_16_caracteres

# ===== Service NFC =====
# CLOUD (Render) : ENABLE_NFC=false (pas de lecteur USB sur le cloud).
# LOCAL (poste avec lecteur ACR122U) : ENABLE_NFC=true.
ENABLE_NFC=true
NFC_READER_TIMEOUT=5000
NFC_MAX_RETRIES=3
NFC_RATE_LIMIT=30
NFC_PIN_ATTEMPTS=3
NFC_SESSION_TIMEOUT=300

# Token partagé entre le backend cloud et le nfc-agent local
# (le nfc-agent l'envoie dans l'en-tête X-Agent-Token pour pousser les lectures).
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NFC_AGENT_TOKEN=remplacez_par_un_token_machine_aleatoire

# ===== Service IA (détection de paiements suspects) =====
# URL du service Flask. Local : http://localhost:5001.
# Prod : URL Render de l'ai-service.
AI_URL=http://localhost:5001
# Exemple prod : AI_URL=https://smart-campus-ai.onrender.com
AI_TIMEOUT_MS=2000
